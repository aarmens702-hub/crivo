# Copy to .env and fill in by hand. Never commit .env; agents are blocked from it.
# Only the analyst half needs a key. crivo.diagnose / crivo.clean / `crivo diagnose` need none.

# Provider: deepseek (default), claude, openai (any OpenAI-compatible endpoint), faux (tests)
CRIVO_PROVIDER=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# For CRIVO_PROVIDER=openai (Ollama, vLLM, OpenRouter, ...)
CRIVO_BASE_URL=
CRIVO_MODEL=
CRIVO_API_KEY=

# Stream budgets for slow endpoints, in seconds
CRIVO_STALL_S=
CRIVO_MAX_CALL_S=

# Remote reads (crivo.read on http/https)
CRIVO_HTTP_TIMEOUT_S=
CRIVO_HTTP_MAX_BYTES=

# MCP server: confine file access to one root, and/or run the kernel in Docker
CRIVO_MCP_ROOT=
CRIVO_MCP_SANDBOX=

# Session workspace, telemetry, and the plan-first gate (off by default)
CRIVO_WORKSPACE=
CRIVO_TELEMETRY=
CRIVO_PLAN_FIRST=
